--- !u!114 &546744425
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 546744424}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 82b3f135f06b578439b80acbabf68d11, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::IntroManager
  displayImage: {fileID: 857577444}
  subtitleText: {fileID: 1985432202}
  imageFitter: {fileID: 857577446}
  fadePanel: {fileID: 1288883161}
  typingSpeed: 0.05
  fadeDuration: 1
  nextSceneName: Battle_Main
  cutsceneSteps:
  - slideImage: {fileID: 8082979983968014272, guid: bf49a49daf775ad4aa502242468fe5de, type: 3}
    dialogs:
    - text: "\uACE0\uD1B5\uC744 \uD0D0\uC2DD\uD558\uB294 '\uC5B4\uB460 \uB9C8\uBC95\uC0AC'"
      waitTime: 3
    - text: "\uADF8\uB294 \uC9C0\uAD6C\uB97C \uC9C0\uD0F1\uD558\uB294 \uC6D0\uC18C\uC758
        \uADE0\uD615\uC744 \uBB34\uB108\uB728\uB824 \uC138\uC0C1\uC744 \n\uD63C\uB3C8\uC5D0
        \uBE60\uB728\uB9AC\uB824 \uD55C\uB2E4."
      waitTime: 3
  - slideImage: {fileID: -8276245627806900309, guid: 6eb5f9d0137aa0646a0062728ec5de40, type: 3}
    dialogs:
    - text: "\uC5B4\uB460 \uB9C8\uBC95\uC0AC\uC758 \uACF5\uACA9\uC73C\uB85C \uADE0\uD615\uC5D0
        \uAE08\uC774 \uAC00\uAE30 \uC2DC\uC791\uD588\uACE0, \uADF8 \uD2C8\uC73C\uB85C
        \n\uBD88\uC548\uC815\uD55C \uC5D0\uB108\uC9C0\uAC00 \uC0C8\uC5B4 \uB098\uC654\uB2E4."
      waitTime: 3
    - text: "\uB3D9\uBB3C\uACFC \uC2DD\uBB3C\uB4E4\uC740 \uADF8 \uAE30\uC6B4\uC5D0
        \uC7A0\uC2DD\uB418\uC5B4 \uC18D\uC131\uC744 \uC9C0\uB2CC \uAD34\uBB3C\uB85C
        \n\uBCC0\uD574\uBC84\uB838\uB2E4."
      waitTime: 3
  - slideImage: {fileID: 1390056864176142894, guid: a482f9c5b7c906e439dcb3f2042f2c00, type: 3}
    dialogs:
    - text: "\uC138\uC0C1\uC774 \uC11C\uC11C\uD788 \uBB34\uB108\uC838 \uB0B4\uB9AC\uB294
        \uAC78 \uC54C\uBA74\uC11C\uB3C4,"
      waitTime: 3
    - text: "\uD3C9\uBC94\uD55C \uC778\uAC04\uC778 \uB098\uB294 \uADF8\uC800 \uACF5\uD3EC\uC5D0
        \uB5A8\uBA70 \uC9C0\uCF1C\uBCFC \uC218\uBC16\uC5D0 \uC5C6\uC5C8\uB2E4."
      waitTime: 3
  - slideImage: {fileID: -3143845608672968736, guid: 2d788cb3ab550dc4c9016253dea5002c, type: 3}
    dialogs:
    - text: "\uADF8\uB54C, \uC5B4\uB460 \uB9C8\uBC95\uC0AC\uC5D0\uAC8C \uACE0\uD5A5\uC744
        \uC783\uC740 \uC6D0\uC18C\uC758 \uC815\uB839\uB4E4\uC774 \uB0B4 \uC55E\uC5D0
        \n\uB098\uD0C0\uB0AC\uB2E4."
      waitTime: 3
    - text: "\uADF8\uB4E4\uC740 \uAC19\uC740 \uBE44\uADF9\uC744 \uB9C9\uAE30 \uC704\uD574
        \uB098\uC5D0\uAC8C \uC790\uC2E0\uB4E4\uC758 \uD798\uC744 \uBE4C\uB824\uC8FC\uC5C8\uB2E4."
      waitTime: 3
  - slideImage: {fileID: -3497513285884944259, guid: 64f4635d9e3b173489aeb35cd24a5550, type: 3}
    dialogs:
    - text: "\uBAA9\uD45C\uB294 \uADF8\uC758 \uACF5\uACA9\uC73C\uB85C\uBD80\uD130
        4\uAC1C\uC758 \uC6D0\uC18C \uAC70\uC810\uC744 \uB05D\uAE4C\uC9C0 \uC9C0\uCF1C\uB0B4\uB294
        \uAC83."
      waitTime: 3
    - text: "\uAC70\uC810\uC774 \uD30C\uAD34\uB418\uBA74 \uC9C0\uAD6C\uC758 \uADE0\uD615\uC740
        \uC644\uC804\uD788 \uBD95\uAD34\uD558\uACE0, \uB3CC\uC774\uD0AC \uC218 \uC5C6\uB294
        \n\uBA78\uB9DD\uC774 \uCC3E\uC544\uC628\uB2E4."
      waitTime: 3
  - slideImage: {fileID: -934912508076396552, guid: 0c10f19785e576e4bbf4232bcf70552f, type: 3}
    dialogs:
    - text: "\uACE7 \uC5B4\uB460 \uB9C8\uBC95\uC0AC\uAC00 \uC9C1\uC811 \uAC70\uC810\uC744
        \uD30C\uAD34\uD558\uAE30 \uC704\uD574 \uBAA8\uC2B5\uC744 \uB4DC\uB7EC\uB0BC
        \uAC83\uC774\uB2E4."
      waitTime: 3
    - text: "\uBB3C\uB7EC\uC124 \uACF3\uC740 \uC5C6\uB2E4. \uB0B4 \uC190\uC73C\uB85C
        \uC774 \uBD95\uAD34\uB97C \uB9C9\uC544\uC57C \uD55C\uB2E4."
      waitTime: 3
